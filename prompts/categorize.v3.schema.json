{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "note_purpose",
    "title",
    "summary",
    "categories",
    "tags",
    "urls",
    "note_has_action_intent",
    "deadline"
  ],
  "properties": {
    "note_purpose": {
      "type": "string",
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "maxLength": 90
    },
    "summary": {
      "type": "string",
      "maxLength": 320
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "{{categories}}"
        ]
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 24
      }
    },
    "urls": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "note_has_action_intent": {
      "type": "boolean"
    },
    "deadline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw",
            "iso",
            "label"
          ],
          "properties": {
            "raw": {
              "type": "string",
              "maxLength": 80
            },
            "iso": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              ]
            },
            "label": {
              "type": "string",
              "maxLength": 80
            }
          }
        }
      ]
    }
  }
}

{
  "name": "clipnest",
  "private": true,
  "version": "0.3.1",
  "description": "Local-first screenshot organizer for Windows with an on-device AI",
  "license": "MIT",
  "author": "Jatin Gupta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
